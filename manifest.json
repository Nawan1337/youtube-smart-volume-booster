{
  "manifest_version": 3,
  "name": "Smart Volume Booster for YouTube™",
  "short_name": "SmartBooster",
  "version": "1.1.5",
  "description": "Normalise et booste automatiquement le volume des vidéos trop basses sur YouTube avec réglage personnalisé par vidéo.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://music.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Volume Booster for YouTube™",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
